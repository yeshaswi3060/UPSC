# Copy this file to .env.local and fill in the values for this environment.
# .env.local is gitignored — never commit real credentials.
# Vite only exposes variables prefixed with VITE_ to client code.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Public client-side payment configuration. Never put Razorpay Key Secret here.
VITE_RAZORPAY_KEY_ID=
VITE_GOOGLE_SCRIPT_URL=

# Server-only payment configuration. Never prefix these with VITE_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SHEET_ID=
SHEET_SYNC_SECRET=
GOOGLE_SCRIPT_URL=
ALLOWED_ORIGIN=
